# Local Arch package of Novel Craft, built from this checkout (not from a download):
#   sh packaging/arch/build.sh        (or: cd packaging/arch && makepkg -si)
# Installs the app to /usr/lib/world-builder and runs it with the system's Electron.
_electron=electron43
pkgname=world-builder
pkgver=1.0.0.r18.f792285
pkgrel=1
pkgdesc="Novel Craft: worldbuilding data store, chapter writer, ledgers, plans and maps for an Obsidian vault"
arch=('any')
license=('MIT')
depends=("$_electron" util-linux)   # util-linux: `script`, the terminal for Claude Code
options=('!strip' '!debug')

_repo="${WB_REPO:-$(realpath "$startdir/../..")}"

pkgver() {
    cd "$_repo"
    printf "%s.r%s.%s" "$(node -p 'require("./package.json").version' 2>/dev/null || echo 1.0.0)" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
    local app="$pkgdir/usr/lib/$pkgname"
    install -d "$app/node_modules"
    cp -r "$_repo"/{server.js,package.json,lib,public,electron} "$app/"
    # the in-app docs: pages, index and screenshots (shots.json only drives scripts/screenshots.mjs)
    install -d "$app/docs"
    cp -r "$_repo"/docs/{*.md,index.json,img} "$app/docs/"
    # runtime dependencies only (pinned in package.json), with what the Anthropic SDK needs
    # (the list is `npm ls --omit=dev --all`; the package check fails if one is missing)
    for m in yaml marked preact htm @xterm/xterm @xterm/addon-fit @anthropic-ai/sdk @babel/runtime @opentelemetry/api @stablelib/base64 fast-sha256 json-schema-to-ts standardwebhooks ts-algebra; do
        install -d "$app/node_modules/$(dirname "$m")"
        cp -r "$_repo/node_modules/$m" "$app/node_modules/$m"
    done
    [ -f "$_repo/LICENSE" ] && install -Dm644 "$_repo/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    install -Dm755 /dev/stdin "$pkgdir/usr/bin/$pkgname" <<SH
#!/bin/sh
exec /usr/bin/$_electron --ozone-platform-hint=auto /usr/lib/$pkgname "\$@"
SH
    install -Dm644 "$_repo/electron/icon.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"
    install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/$pkgname.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Novel Craft
Comment=Worldbuilding, chapter writing and ledgers for your Obsidian vault
Exec=$pkgname %U
Icon=$pkgname
Terminal=false
Categories=Office;WordProcessor;
StartupWMClass=$pkgname
DESKTOP
}
