{
  "name": "world-builder",
  "version": "1.0.1",
  "private": true,
  "description": "Local web app for novels in an Obsidian vault: worldbuilding data store, chapter ledgers, plans, world and map builder",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "app": "sh scripts/electron.sh .",
    "package:arch": "sh packaging/arch/build.sh",
    "test": "sh test/run.sh",
    "scaffold": "node scripts/scaffold.js",
    "demo": "node scripts/demo-vault.js",
    "screenshots": "node scripts/screenshots.mjs",
    "dist": "electron-builder --publish never",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "htm": "3.1.1",
    "marked": "18.1.1",
    "preact": "11.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "electron": "43.8.7",
    "electron-builder": "26.18.1",
    "jsdom": "26.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheRealWolfick/novel-craft.git"
  },
  "allowScripts": {
    "electron-winstaller": false
  },
  "author": "TheRealWolfick",
  "homepage": "https://github.com/TheRealWolfick/novel-craft",
  "build": {
    "appId": "io.github.therealwolfick.novelcraft",
    "productName": "Novel Craft",
    "copyright": "Copyright © 2026 TheRealWolfick",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "server.js",
      "package.json",
      "LICENSE",
      "lib/**",
      "public/**",
      "electron/**",
      "docs/*.md",
      "docs/index.json",
      "docs/img/**"
    ],
    "afterPack": "scripts/adhoc-sign.cjs",
    "artifactName": "Novel-Craft-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "novel-craft",
      "category": "Office",
      "synopsis": "Novel writing, worldbuilding and maps for an Obsidian vault",
      "description": "Novel Craft: worldbuilding data store, chapter writer, ledgers, plans and maps for an Obsidian vault",
      "desktop": {
        "entry": {
          "StartupWMClass": "novel-craft"
        }
      },
      "maintainer": "TheRealWolfick <TheRealWolfick@users.noreply.github.com>"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false
    }
  },
  "desktopName": "novel-craft.desktop"
}
